# Cpp-VPN-Core Windows test client: key=value, '#' starts a comment.
# Precedence: defaults < this file < command-line arguments.

server=127.0.0.1
port=5555

# v1 (XOR, insecure) | v2 (Noise IK + AEAD, design 02)
protocol=v1
# v2: the node's public key (on the node: vpn_server --pubkey /etc/cppvpn/node.key)
# server_pub=
# v2: this client's key file (vpn_client --gen-key client.key); its public key goes into the
# node's /etc/cppvpn/allowed_clients
client_key=client.key
# v2: ciphers offered, in preference order
offer=chacha20poly1305,aes256gcm
# v2: start a new handshake after this many seconds (design 02 section 7)
rekey_after=120

# error | warn | info | debug
log_level=info
# log_file=vpn_client.log

# Tunnel mode
mtu=1400
# dns=1.1.1.1
route_all_traffic=false
reconnect=true
reconnect_delay=5
reconnect_max_attempts=0

# Keepalive every N seconds (the server removes clients after 60 s of silence)
keepalive_interval=15
# Seconds without downstream data before reconnecting. 0 = disabled.
# Keep it 0 with protocol v1: the server sends nothing to idle clients.
timeout=0

# Probe mode (--probe): seconds of keepalives before BYE
probe_duration=20
